[Unit]
Description=Summarize NewAPI GPTPro TTFT routing for the previous hour
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/newapi-gptpro-ttft-router --summarize-hourly
User=root
Group=root
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/newapi-gptpro-ttft-router

