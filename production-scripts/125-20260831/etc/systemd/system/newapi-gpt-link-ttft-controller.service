[Unit]
Description=Monitor and rebalance NewAPI GPT对接组 by recent TTFT
After=docker.service
Requires=docker.service
ConditionPathExists=/var/run/docker.sock

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/newapi-gpt-link-ttft-controller --window-seconds 30 --threshold-ms 4000 --min-samples 2 --min-window-requests 2 --recent-limit 30 --error-threshold 3 --unavailable-error-threshold 10 --unavailable-min-attempts 10 --unavailable-max-success-rate 0.1 --min-weight 1 --total-weight 1000 --max-step 0 --event-log /var/log/newapi-gpt-link-ttft-controller/events.jsonl
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=newapi-gpt-link-ttft-controller
ReadWritePaths=/var/lib/newapi-gpt-link-ttft-controller /var/log/newapi-gpt-link-ttft-controller /run
