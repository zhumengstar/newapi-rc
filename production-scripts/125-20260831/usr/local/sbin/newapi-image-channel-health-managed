#!/usr/bin/env python3
"""Run the image probe while keeping channel 241 explicitly quarantined."""

from __future__ import annotations

import json
import os
import subprocess
import tempfile
from pathlib import Path

STATE = Path('/var/lib/newapi-image-channel-health/state.json')
PG = [
    'docker', 'exec', 'newapi-standalone-postgres', 'psql', '-X',
    '-v', 'ON_ERROR_STOP=1', '-U', 'newapi', '-d', 'new-api', '-Atq',
]
QUARANTINE_REASON = '图片健康探测托管：渠道 241 固定隔离'


def run_sql(sql: str) -> None:
    subprocess.run(PG + ['-c', sql], check=True, stdout=subprocess.DEVNULL)


def quarantine_channel_241() -> None:
    run_sql(f"""
UPDATE channels
SET status = 3,
    weight = 0,
    priority = 99,
    other = jsonb_set(
        CASE WHEN coalesce(other, '') = '' THEN '{{}}'::jsonb ELSE other::jsonb END,
        '{{status_reason}}', to_jsonb('{QUARANTINE_REASON}'::text), true
    )::text,
    other_info = jsonb_set(
        CASE WHEN coalesce(other_info, '') = '' THEN '{{}}'::jsonb ELSE other_info::jsonb END,
        '{{status_reason}}', to_jsonb('{QUARANTINE_REASON}'::text), true
    )::text
WHERE id = 241 AND btrim(coalesce("group", '')) = '生成图片组';
""")


def prepare_quarantine() -> None:
    quarantine_channel_241()
    if not STATE.exists():
        return
    data = json.loads(STATE.read_text(encoding='utf-8'))
    entry = data.setdefault('channels', {}).setdefault('241', {})
    entry['managed'] = False
    entry['quarantined'] = True
    entry.pop('last_ok', None)
    fd, name = tempfile.mkstemp(prefix='.state.', dir=STATE.parent)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            json.dump(data, handle, ensure_ascii=False, separators=(',', ':'))
            handle.write('\n')
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(name, 0o600)
        os.replace(name, STATE)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def apply_weights() -> None:
    run_sql("""
UPDATE channels
SET weight = CASE id WHEN 224 THEN 2 WHEN 242 THEN 1 WHEN 245 THEN 3 ELSE 0 END,
    priority = CASE id WHEN 224 THEN 2 WHEN 242 THEN 3 WHEN 245 THEN 2 ELSE 99 END
WHERE id IN (224, 242, 245)
  AND btrim(coalesce("group", '')) = '生成图片组'
  AND status = 1;
UPDATE channels SET weight = 0, priority = 99
WHERE id IN (224, 242, 245)
  AND btrim(coalesce("group", '')) = '生成图片组'
  AND status = 3;
""")
    quarantine_channel_241()


def main() -> int:
    prepare_quarantine()
    proc = subprocess.run(['/usr/local/sbin/newapi-image-channel-health', '--timeout', '90'])
    apply_weights()
    return proc.returncode


raise SystemExit(main())
