#!/usr/bin/env python3
"""Rebalance one isolated NewAPI group by recent real-request metrics.

The controller never sends an upstream probe and never changes a channel's
status, auto-ban setting, or priority.  It only changes the weight of enabled
abilities belonging to an exact, non-shared group.  Scores use the latest five
minutes of terminal request logs: success rate, P95 request duration, TTFT,
and the cost multiplier encoded in the channel name. A lower cost multiplier
is preferred when reliability and latency are comparable.
"""

from __future__ import annotations

import argparse
import base64
import fcntl
import hashlib
import json
import math
import os
import re
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path


POSTGRES_CONTAINER = "newapi-standalone-postgres"
POSTGRES_USER = "newapi"
POSTGRES_DB = "new-api"
DEFAULT_GROUP = "gpt特惠组"
DEFAULT_STATE = Path("/var/lib/newapi-gpt-weight-controller/state.json")
DEFAULT_LOCK = Path("/run/newapi-gpt-weight-controller.lock")


@dataclass
class Channel:
    channel_id: int
    name: str
    priority: int
    weight: int
    attempts: int
    success: int
    failed: int
    avg_seconds: float
    p95_seconds: float
    ttft_samples: int
    avg_ttft_ms: float

    @property
    def cost_multiplier(self) -> float:
        """Read explicit ratios and the legacy numeric channel-name prefix."""
        explicit = re.search(
            r"(?<![0-9])([0-9]+(?:\.[0-9]+)?)\s*(?:[-_ ]?倍率|x)",
            self.name,
            re.IGNORECASE,
        )
        if explicit:
            value = float(explicit.group(1))
            return value if value > 0 else 1.0

        match = re.match(r"^\s*(0?\.\d+)\s*[-_ ]", self.name)
        if match:
            value = float(match.group(1))
            return value if value > 0 else 1.0

        match = re.match(r"^\s*(0\d{2,3})(?:-|$)", self.name)
        if not match:
            return 1.0
        digits = match.group(1)
        value = int(digits) / (10 ** (len(digits) - 1))
        return value if value > 0 else 1.0

    @property
    def success_rate(self) -> float:
        return self.success / self.attempts if self.attempts else 0.0

    def score(self) -> float:
        # Beta prior prevents one or two lucky requests from taking all traffic.
        smoothed_success = (self.success + 18.0) / (self.attempts + 20.0)
        duration_factor = 1.0 + min(max(self.p95_seconds, 0.0), 300.0) / 60.0
        ttft_factor = 1.0 + min(max(self.avg_ttft_ms, 0.0), 120_000.0) / 60_000.0
        cost_factor = max(self.cost_multiplier, 0.01)
        return math.pow(smoothed_success, 5) / (cost_factor * duration_factor * ttft_factor)


def run_psql(sql: str) -> str:
    proc = subprocess.run(
        [
            "docker", "exec", POSTGRES_CONTAINER, "psql", "-X",
            "-v", "ON_ERROR_STOP=1", "-U", POSTGRES_USER, "-d", POSTGRES_DB,
            "-Atq", "-F", "\t", "-c", sql,
        ],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=45,
    )
    if proc.returncode != 0:
        raise RuntimeError(f"psql failed with exit code {proc.returncode}: {proc.stderr.strip()}")
    return proc.stdout


def sql_text(value: str) -> str:
    encoded = base64.b64encode(value.encode("utf-8")).decode("ascii")
    return f"convert_from(decode('{encoded}', 'base64'), 'UTF8')"


def decode_text(value: str) -> str:
    return base64.b64decode(value).decode("utf-8", errors="replace") if value else ""


def load_state(path: Path) -> dict:
    if not path.exists():
        return {"version": 1, "last_plan": {}}
    data = json.loads(path.read_text(encoding="utf-8"))
    if data.get("version") != 1:
        raise RuntimeError("unsupported state version")
    data.setdefault("last_plan", {})
    return data


def save_state(path: Path, state: dict) -> None:
    path.parent.mkdir(mode=0o750, parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=".state.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(state, handle, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp_name, 0o600)
        os.replace(temp_name, path)
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)


def fetch_channels(group: str, window_seconds: int) -> dict[int, Channel]:
    group_sql = sql_text(group)
    sql = f"""
WITH group_channels AS (
  SELECT c.id, c.name, c.priority, c.weight
  FROM channels c
  WHERE c.status = 1
    AND btrim(coalesce(c."group", '')) = {group_sql}
    AND EXISTS (
      SELECT 1 FROM abilities a WHERE a.channel_id = c.id AND a.enabled
    )
), terminal_logs AS (
  -- NewAPI retries can create more than one log row for one channel/request.
  -- Keep the final row per channel and request id, but count retries on a
  -- different channel independently because they are separate upstream calls.
  SELECT DISTINCT ON (
    l.channel_id, coalesce(nullif(l.request_id, ''), 'log:' || l.id::text)
  ) l.channel_id, l.type, l.quota, l.use_time, l.other
  FROM logs l
  JOIN group_channels gc ON gc.id = l.channel_id
  WHERE l.created_at >= extract(epoch FROM now())::bigint - {int(window_seconds)}
    AND l.type IN (2, 5)
  ORDER BY l.channel_id,
           coalesce(nullif(l.request_id, ''), 'log:' || l.id::text),
           l.id DESC
), stats AS (
  SELECT channel_id,
         count(*) AS attempts,
         count(*) FILTER (WHERE type = 2 AND quota > 0) AS success,
         count(*) FILTER (WHERE type = 5 OR (type = 2 AND quota <= 0)) AS failed,
         coalesce(avg(use_time) FILTER (WHERE type = 2 AND quota > 0), 120) AS avg_seconds,
         coalesce(percentile_cont(0.95) WITHIN GROUP (ORDER BY use_time)
           FILTER (WHERE type = 2 AND quota > 0), 120) AS p95_seconds,
         count(*) FILTER (
           WHERE type = 2 AND quota > 0 AND coalesce(other, '') <> ''
             AND (other::jsonb->>'frt') ~ '^[0-9]+([.][0-9]+)?$'
         ) AS ttft_samples,
         coalesce(avg((other::jsonb->>'frt')::numeric) FILTER (
           WHERE type = 2 AND quota > 0 AND coalesce(other, '') <> ''
             AND (other::jsonb->>'frt') ~ '^[0-9]+([.][0-9]+)?$'
         ), 0) AS avg_ttft_ms
  FROM terminal_logs
  GROUP BY channel_id
)
SELECT gc.id,
       replace(encode(convert_to(coalesce(gc.name, ''), 'UTF8'), 'base64'), E'\\n', ''),
       gc.priority, gc.weight,
       coalesce(s.attempts, 0), coalesce(s.success, 0), coalesce(s.failed, 0),
       coalesce(s.avg_seconds, 120), coalesce(s.p95_seconds, 120),
       coalesce(s.ttft_samples, 0), coalesce(s.avg_ttft_ms, 0)
FROM group_channels gc
LEFT JOIN stats s ON s.channel_id = gc.id
ORDER BY gc.id;
"""
    channels: dict[int, Channel] = {}
    for line in run_psql(sql).splitlines():
        fields = line.split("\t")
        if len(fields) != 11:
            continue
        channels[int(fields[0])] = Channel(
            channel_id=int(fields[0]), name=decode_text(fields[1]), priority=int(fields[2]),
            weight=int(fields[3]), attempts=int(fields[4]), success=int(fields[5]),
            failed=int(fields[6]), avg_seconds=float(fields[7]), p95_seconds=float(fields[8]),
            ttft_samples=int(fields[9]), avg_ttft_ms=float(fields[10]),
        )
    return channels


def allocate_targets(channels: dict[int, Channel], min_attempts: int, min_weight: int) -> dict[int, int]:
    """Redistribute the current total weight only among sufficiently sampled channels."""
    sampled = [item for item in channels.values() if item.attempts >= min_attempts]
    if not sampled:
        return {}

    # Newly added channels remain at their current/minimum weight until they
    # have enough real traffic. This keeps a fresh channel available without
    # allowing one lucky request to take over the group.
    unsampled = [item for item in channels.values() if item.attempts < min_attempts]
    total_budget = max(sum(max(item.weight, min_weight) for item in channels.values()), len(channels) * min_weight)
    fixed_weight = sum(max(item.weight, min_weight) for item in unsampled)
    available = max(total_budget - fixed_weight, len(sampled) * min_weight)
    distributable = available - len(sampled) * min_weight
    score_total = sum(item.score() for item in sampled)
    targets = {item.channel_id: min_weight for item in sampled}
    if score_total <= 0:
        return targets

    fractions: list[tuple[float, int]] = []
    assigned = 0
    for item in sampled:
        share = distributable * item.score() / score_total
        whole = int(math.floor(share))
        targets[item.channel_id] += whole
        assigned += whole
        fractions.append((share - whole, item.channel_id))
    for _, channel_id in sorted(fractions, reverse=True)[:distributable - assigned]:
        targets[channel_id] += 1
    return targets


def bounded_weight(current: int, target: int, max_step: int) -> int:
    return max(1, min(current + max_step, max(current - max_step, target)))


def update_weight(group: str, channel_id: int, weight: int) -> None:
    group_sql = sql_text(group)
    updated_at = int(time.time())
    update_json = json.dumps({
        "channel_update_time": updated_at,
        "channel_update_source": Path(__file__).name,
        "channel_update_action": "weight",
        "weight_update_time": updated_at,
    }, ensure_ascii=False)
    update_sql = sql_text(update_json)
    sql = f"""
BEGIN;
WITH updated AS (
  UPDATE channels
  SET weight = {int(weight)},
      other = (coalesce(nullif(other, ''), '{{}}')::jsonb || {update_sql}::jsonb)::text,
      other_info = (coalesce(nullif(other_info, ''), '{{}}')::jsonb || {update_sql}::jsonb)::text
  WHERE id = {int(channel_id)}
    AND status = 1
    AND btrim(coalesce("group", '')) = {group_sql}
  RETURNING id
)
UPDATE abilities
SET weight = {int(weight)}
FROM updated
WHERE abilities.channel_id = updated.id AND abilities.enabled;
COMMIT;
"""
    run_psql(sql)


def bootstrap_new_channels(
    group: str,
    channels: dict[int, Channel],
    state: dict,
    min_weight: int,
    dry_run: bool,
) -> list[dict]:
    """Give channels added after initialization a controlled first sample."""
    if not state.get("initialized"):
        return []
    known = {str(channel_id) for channel_id in state.get("last_plan", {})}
    actions: list[dict] = []
    for channel in channels.values():
        if str(channel.channel_id) in known or channel.weight == min_weight:
            continue
        actions.append({
            "channel": channel.channel_id,
            "action": "bootstrap_new_channel",
            "from_weight": channel.weight,
            "to_weight": min_weight,
            "cost_multiplier": round(channel.cost_multiplier, 6),
        })
        if not dry_run:
            update_weight(group, channel.channel_id, min_weight)
            channel.weight = min_weight
    return actions


def self_test() -> None:
    fast = Channel(1, "0065-fast", 99, 10, 30, 30, 0, 4, 6, 30, 700)
    slow = Channel(2, "0065-slow", 99, 10, 30, 20, 10, 20, 30, 30, 3_000)
    targets = allocate_targets({1: fast, 2: slow}, min_attempts=3, min_weight=1)
    assert targets[1] > targets[2]
    assert bounded_weight(10, 30, 5) == 15
    assert bounded_weight(10, 1, 5) == 5
    assert allocate_targets({1: fast}, min_attempts=99, min_weight=1) == {}
    assert Channel(3, "0065-cheap", 99, 1, 3, 3, 0, 1, 1, 0, 0).cost_multiplier == 0.065
    assert Channel(4, "0.5倍率-fast", 99, 1, 3, 3, 0, 1, 1, 0, 0).cost_multiplier == 0.5
    assert Channel(5, "standard 0.8x", 99, 1, 3, 3, 0, 1, 1, 0, 0).cost_multiplier == 0.8
    cheap = Channel(6, "0.02-cheap", 99, 1, 10, 10, 0, 10, 10, 0, 0)
    expensive = Channel(7, "1-expensive", 99, 1, 10, 10, 0, 10, 10, 0, 0)
    assert cheap.score() > expensive.score()
    print("self-test: ok")


def lock_path_for_group(group: str, explicit: Path | None) -> Path:
    if explicit is not None:
        return explicit
    safe_group = re.sub(r"[^A-Za-z0-9_.-]+", "_", group).strip("_") or "group"
    group_hash = hashlib.sha256(group.encode("utf-8")).hexdigest()[:12]
    return DEFAULT_LOCK.with_name(f"{DEFAULT_LOCK.stem}-{safe_group}-{group_hash}{DEFAULT_LOCK.suffix}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Rebalance an isolated NewAPI group using recent real request logs.")
    parser.add_argument("--group", default=DEFAULT_GROUP)
    parser.add_argument("--window-seconds", type=int, default=300)
    parser.add_argument("--min-attempts", type=int, default=3)
    parser.add_argument("--min-weight", type=int, default=1)
    parser.add_argument("--max-step", type=int, default=5)
    parser.add_argument("--state", type=Path, default=DEFAULT_STATE)
    parser.add_argument("--lock", type=Path)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    if args.self_test:
        self_test()
        return 0
    if args.window_seconds < 60 or args.min_attempts < 1 or args.min_weight < 1 or args.max_step < 1:
        raise ValueError("window-seconds >= 60 and min-attempts/min-weight/max-step >= 1 are required")

    lock_path = lock_path_for_group(args.group, args.lock)
    lock_path.parent.mkdir(mode=0o750, parents=True, exist_ok=True)
    with lock_path.open("w") as lock_handle:
        fcntl.flock(lock_handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        channels = fetch_channels(args.group, args.window_seconds)
        state = load_state(args.state)
        actions: list[dict] = bootstrap_new_channels(
            args.group, channels, state, args.min_weight, args.dry_run
        )
        targets = allocate_targets(channels, args.min_attempts, args.min_weight)
        for channel_id, target in sorted(targets.items()):
            channel = channels[channel_id]
            desired = bounded_weight(channel.weight, target, args.max_step)
            if desired == channel.weight:
                continue
            actions.append({
                "channel": channel_id, "from_weight": channel.weight, "to_weight": desired,
                "target_weight": target,
                "cost_multiplier": round(channel.cost_multiplier, 6),
                "cost_factor": round(max(channel.cost_multiplier, 0.01), 6),
                "success_rate": round(channel.success_rate, 4),
                "p95_seconds": round(channel.p95_seconds, 3),
                "avg_seconds": round(channel.avg_seconds, 3),
                "avg_ttft_ms": round(channel.avg_ttft_ms, 1),
            })
            if not args.dry_run:
                update_weight(args.group, channel_id, desired)
                channel.weight = desired

        state["last_plan"] = {
            str(channel_id): {"weight": channel.weight, "attempts": channel.attempts}
            for channel_id, channel in channels.items()
        }
        state["initialized"] = True
        state["updated_at"] = int(time.time())
        if not args.dry_run:
            save_state(args.state, state)

        print(json.dumps({
            "group": args.group, "window_seconds": args.window_seconds,
            "channels": [
                {
                    "channel": item.channel_id, "priority": item.priority, "weight": item.weight,
                    "attempts": item.attempts, "success": item.success, "failed": item.failed,
                    "success_rate": round(item.success_rate, 4), "avg_seconds": round(item.avg_seconds, 3),
                    "p95_seconds": round(item.p95_seconds, 3), "avg_ttft_ms": round(item.avg_ttft_ms, 1),
                    "cost_multiplier": round(item.cost_multiplier, 6),
                    "cost_factor": round(max(item.cost_multiplier, 0.01), 6),
                    "score": round(item.score(), 8),
                }
                for item in channels.values()
            ],
            "actions": actions, "dry_run": args.dry_run,
            "invariants": {"priority_changed": False, "status_changed": False, "upstream_probe": False},
        }, ensure_ascii=False, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BlockingIOError:
        print("another instance is running")
        raise SystemExit(0)
    except Exception as exc:
        print(f"controller failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        raise SystemExit(1)
