#!/usr/bin/env python3
"""Run bounded, direct upstream TTFT tests for gpt-5.6-sol in gpt特惠组."""

from __future__ import annotations

import argparse
import base64
import concurrent.futures
import json
import os
import subprocess
import time
import urllib.error
import urllib.request
from pathlib import Path


POSTGRES_CONTAINER = "newapi-standalone-postgres"
POSTGRES_USER = "newapi"
POSTGRES_DB = "new-api"
TARGET_MODEL = "gpt-5.6-sol"
TARGET_GROUP = "gpt特惠组"


def run_psql(sql: str) -> str:
    proc = subprocess.run(
        [
            "docker", "exec", "-i", POSTGRES_CONTAINER, "psql", "-X",
            "-v", "ON_ERROR_STOP=1", "-U", POSTGRES_USER, "-d", POSTGRES_DB,
            "-Atq", "-F", "\t", "-c", sql,
        ],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=45,
    )
    if proc.returncode:
        raise RuntimeError(f"psql failed: {' '.join(proc.stderr.split())[:500]}")
    return proc.stdout


def fetch_channels() -> list[dict]:
    sql = f"""
SELECT id, status,
       replace(encode(convert_to(coalesce(base_url, ''), 'UTF8'), 'base64'), E'\\n', ''),
       replace(encode(convert_to(coalesce(key, ''), 'UTF8'), 'base64'), E'\\n', ''),
       replace(encode(convert_to(coalesce(models, ''), 'UTF8'), 'base64'), E'\\n', ''),
       replace(encode(convert_to(coalesce(model_mapping, '{{}}'), 'UTF8'), 'base64'), E'\\n', '')
FROM channels
WHERE "group" ILIKE '%{TARGET_GROUP}%'
  AND models ILIKE '%{TARGET_MODEL}%'
ORDER BY id;
"""
    rows = []
    for line in run_psql(sql).splitlines():
        fields = line.split("\t")
        if len(fields) != 6:
            continue
        decode = lambda value: base64.b64decode(value).decode("utf-8", errors="replace") if value else ""
        try:
            rows.append({
                "id": int(fields[0]),
                "status": int(fields[1]),
                "base_url": decode(fields[2]).rstrip("/"),
                "key": decode(fields[3]),
                "models": [x.strip() for x in decode(fields[4]).split(",") if x.strip()],
                "mapping": json.loads(decode(fields[5]) or "{}"),
            })
        except (ValueError, json.JSONDecodeError):
            continue
    return rows


def error_detail(status: int, body: bytes) -> str:
    text = " ".join(body.decode("utf-8", errors="replace").split())
    try:
        payload = json.loads(text)
        error = payload.get("error", payload) if isinstance(payload, dict) else {}
        if isinstance(error, dict):
            code = error.get("code") or error.get("type") or ""
            message = error.get("message") or ""
            if code or message:
                return f"HTTP {status}; code={code}; message={str(message)[:400]}"
    except json.JSONDecodeError:
        pass
    return f"HTTP {status}; {text[:400]}"


def extract_token(data: bytes) -> bool:
    text = data.decode("utf-8", errors="replace")
    for line in text.splitlines():
        if not line.startswith("data:"):
            continue
        payload = line[5:].strip()
        if not payload or payload == "[DONE]":
            continue
        try:
            obj = json.loads(payload)
        except json.JSONDecodeError:
            if payload:
                return True
            continue
        choices = obj.get("choices", []) if isinstance(obj, dict) else []
        if choices:
            choice = choices[0] or {}
            delta = choice.get("delta") or {}
            if any(str(delta.get(key, "")) for key in ("content", "reasoning_content", "text")):
                return True
            message = choice.get("message") or {}
            if any(str(message.get(key, "")) for key in ("content", "reasoning_content", "text")):
                return True
        if isinstance(obj, dict) and (obj.get("output_text") or obj.get("text")):
            return True
    return False


def probe(channel: dict, round_no: int, prompt: str, timeout: int) -> dict:
    started = time.time()
    result = {
        "channel_id": channel["id"],
        "channel_status_before": channel["status"],
        "round": round_no,
        "model": TARGET_MODEL,
        "input_chars": len(prompt),
        "ok": False,
        "http_status": None,
        "first_byte_ms": None,
        "ttft_ms": None,
        "total_ms": None,
        "error": None,
    }
    model = str(channel["mapping"].get(TARGET_MODEL, TARGET_MODEL))
    result["upstream_model"] = model
    payload = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": 8,
        "stream": True,
    }
    request = urllib.request.Request(
        f"{channel['base_url']}/v1/chat/completions",
        data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
        method="POST",
        headers={
            "Authorization": f"Bearer {channel['key']}",
            "Content-Type": "application/json",
            "Accept": "text/event-stream",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            result["http_status"] = response.status
            first_byte_at = None
            token_at = None
            buffer = b""
            while True:
                chunk = response.read(4096)
                if not chunk:
                    break
                now = time.time()
                if first_byte_at is None:
                    first_byte_at = now
                    result["first_byte_ms"] = round((now - started) * 1000, 2)
                buffer += chunk
                if token_at is None and extract_token(buffer):
                    token_at = now
                    result["ttft_ms"] = round((now - started) * 1000, 2)
                if len(buffer) > 200_000:
                    buffer = buffer[-50_000:]
            result["total_ms"] = round((time.time() - started) * 1000, 2)
            result["ok"] = bool(result["ttft_ms"] is not None)
            if not result["ok"]:
                result["error"] = "stream ended without text token"
    except urllib.error.HTTPError as exc:
        result["http_status"] = exc.code
        result["error"] = error_detail(exc.code, exc.read(4096))
        result["total_ms"] = round((time.time() - started) * 1000, 2)
    except Exception as exc:
        result["error"] = f"{type(exc).__name__}: {str(exc)[:300]}"
        result["total_ms"] = round((time.time() - started) * 1000, 2)
    return result


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--rounds", type=int, default=10)
    parser.add_argument("--input-chars", type=int, default=100_000)
    parser.add_argument("--concurrency", type=int, default=4)
    parser.add_argument("--timeout", type=int, default=240)
    parser.add_argument("--output-dir", type=Path, default=Path("/var/log/newapi-gpt-special-ttft"))
    args = parser.parse_args()
    if args.rounds < 1 or args.input_chars < 1 or args.concurrency < 1:
        raise SystemExit("rounds, input-chars and concurrency must be positive")
    channels = fetch_channels()
    if not channels:
        raise SystemExit("no matching channels")
    prompt = ("这是一段用于模型性能测试的中文输入文本。请完整读取上下文后，仅回复收到。\n" *
              ((args.input_chars // 34) + 1))[:args.input_chars]
    args.output_dir.mkdir(mode=0o750, parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d_%H%M%S")
    result_path = args.output_dir / f"run-{stamp}.jsonl"
    summary_path = args.output_dir / f"summary-{stamp}.json"
    meta = {
        "started_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "group": TARGET_GROUP,
        "model": TARGET_MODEL,
        "channels": len(channels),
        "enabled_before": sum(channel["status"] == 1 for channel in channels),
        "rounds": args.rounds,
        "input_chars": args.input_chars,
        "concurrency": args.concurrency,
        "note": "direct upstream test; database channel status is not modified",
    }
    result_path.write_text(json.dumps({"meta": meta}, ensure_ascii=False) + "\n", encoding="utf-8")
    jobs = [(channel, round_no) for channel in channels for round_no in range(1, args.rounds + 1)]
    with result_path.open("a", encoding="utf-8") as output:
        with concurrent.futures.ThreadPoolExecutor(max_workers=args.concurrency) as pool:
            futures = [pool.submit(probe, channel, round_no, prompt, args.timeout) for channel, round_no in jobs]
            for future in concurrent.futures.as_completed(futures):
                result = future.result()
                output.write(json.dumps(result, ensure_ascii=False) + "\n")
                output.flush()
                print(json.dumps(result, ensure_ascii=False), flush=True)
    rows = [json.loads(line) for line in result_path.read_text(encoding="utf-8").splitlines()[1:] if line.strip()]
    summary = {"meta": meta, "channels": []}
    for channel in channels:
        items = [row for row in rows if row["channel_id"] == channel["id"]]
        successful = [row for row in items if row["ttft_ms"] is not None]
        summary["channels"].append({
            "channel_id": channel["id"],
            "status_before": channel["status"],
            "rounds": len(items),
            "successes": len(successful),
            "failures": len(items) - len(successful),
            "avg_ttft_ms": round(sum(row["ttft_ms"] for row in successful) / len(successful), 2) if successful else None,
            "min_ttft_ms": min((row["ttft_ms"] for row in successful), default=None),
            "max_ttft_ms": max((row["ttft_ms"] for row in successful), default=None),
            "avg_total_ms": round(sum(row["total_ms"] for row in items) / len(items), 2) if items else None,
            "errors": sorted({row["error"] for row in items if row["error"]})[:10],
        })
    summary["channels"].sort(key=lambda row: (row["avg_ttft_ms"] is None, row["avg_ttft_ms"] or 0))
    summary_path.write_text(json.dumps(summary, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps({"result": str(result_path), "summary": str(summary_path)}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
